generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuarterProgram {
  id             Int                    @id @default(autoincrement())
  branchId       String
  year           Int
  quarter        Int
  status         ProgramStatus          @default(DRAFT)
  note           String?
  version        Int                    @default(1)
  approvedById   Int?
  createdBy      Int?
  updatedBy      Int?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lessons        ProgramLesson[]
  approvals      ProgramApproval[]
  approvalTokens ProgramApprovalToken[]

  @@unique([branchId, year, quarter])
  @@index([branchId])
  @@index([year, quarter])
}

model ProgramLesson {
  id                      Int                 @id @default(autoincrement())
  quarterProgramId        Int
  date                    DateTime
  lessonText              String
  prepared                Boolean             @default(false)
  durationMinutes         Int?
  plannedParticipantCount Int?                @default(0)
  actualParticipantCount  Int?                @default(0)
  commonProgramCode       String?
  locationCode            String?
  note                    String?
  evaluationPercent       Float?
  coreSessionId           Int?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  evaluations             ProgramEvaluation[]
  files                   ProgramFile[]
  leaders                 ProgramLeader[]
  quarterProgram          QuarterProgram      @relation(fields: [quarterProgramId], references: [id], onDelete: Cascade)

  @@index([quarterProgramId])
  @@index([date])
  @@index([coreSessionId])
}

model ProgramLeader {
  id              Int           @id @default(autoincrement())
  programLessonId Int
  userId          Int
  role            String        @default("MAIN")
  createdAt       DateTime      @default(now())
  programLesson   ProgramLesson @relation(fields: [programLessonId], references: [id], onDelete: Cascade)

  @@unique([programLessonId, userId])
  @@index([programLessonId])
  @@index([userId])
}

model ProgramFile {
  id                 Int           @id @default(autoincrement())
  programLessonId    Int
  originalName       String
  fileName           String
  mimeType           String
  size               Int
  cloudinaryPublicId String
  cloudinaryUrl      String
  createdAt          DateTime      @default(now())
  programLesson      ProgramLesson @relation(fields: [programLessonId], references: [id], onDelete: Cascade)

  @@index([programLessonId])
}

model ProgramEvaluation {
  id              Int           @id @default(autoincrement())
  programLessonId Int
  evaluatorId     Int?
  percent         Float?
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  programLesson   ProgramLesson @relation(fields: [programLessonId], references: [id], onDelete: Cascade)

  @@index([programLessonId])
}

model ProgramApproval {
  id               Int                   @id @default(autoincrement())
  quarterProgramId Int
  reviewerId       Int
  action           ProgramApprovalAction
  comment          String?
  version          Int
  createdAt        DateTime              @default(now())
  quarterProgram   QuarterProgram        @relation(fields: [quarterProgramId], references: [id], onDelete: Cascade)

  @@index([quarterProgramId, version, action])
  @@index([quarterProgramId, createdAt])
}

model ProgramApprovalToken {
  id               Int                        @id @default(autoincrement())
  token            String                     @unique
  quarterProgramId Int
  reviewerId       Int
  version          Int
  status           ProgramApprovalTokenStatus @default(PENDING)
  expiredAt        DateTime
  createdAt        DateTime                   @default(now())
  quarterProgram   QuarterProgram             @relation(fields: [quarterProgramId], references: [id], onDelete: Cascade)

  @@index([quarterProgramId, reviewerId, version])
}

enum ProgramStatus {
  DRAFT
  PENDING
  NEED_REVISION
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ProgramApprovalAction {
  APPROVE
  REJECT
  RESUBMIT
}

enum ProgramApprovalTokenStatus {
  PENDING
  APPROVED
  REJECTED
}
